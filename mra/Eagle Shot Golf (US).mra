    <dip bits="0,3" name="Coinage" ids="4C/1C,3C/1C,2C/1C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,Multi A,Multi B,Multi C,Multi D,Multi E" values="7,8,9,15,6,14,13,12,11,10,5,4,3,2,1"/>
    <dip bits="4" name="Credits To Start" ids="1,2" values="1,0"/>
