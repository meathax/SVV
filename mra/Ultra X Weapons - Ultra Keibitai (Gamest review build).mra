<misterromdescription>
  <!-- Generated by tools/gen_ssv_mras.py from MAME ssv.cpp.
       Stream offsets: program 0x0000000-0x01FFFFF; graphics 0x0200000-0x0AFFFFF; samples 0x0B00000-0x12FFFFF
       ES5506 bank aliases (ROM_COPY in MAME, address aliases rather than data, so not duplicated here): ensoniq.2 aliases ensoniq.0; ensoniq.3 aliases ensoniq.1
       Switches MAME defines that an MRA cannot express, left out and still at their default: Region (DSW2 mask 0x14, non-contiguous)
       NOT YET SUPPORTED by the SSV core: rtl/mem/ssv_rom_loader.sv takes a fixed Dyna Gear stream (1 MB program, graphics as three 4 MB quarters, 4 MB samples) and this set does not match it. The ROM description below is correct and will work once the loader is generalised. -->
  <name>Ultra X Weapons / Ultra Keibitai (Gamest review build)</name>
  <setname>ultraxg</setname>
  <year>1995</year>
  <manufacturer>Banpresto / Tsuburaya Productions / Seta</manufacturer>
  <rbf>SSV</rbf>
  <!-- MAME rotation ROT270; the core does not rotate. -->
  <rom index="1">
    <part>5301020C0F0103440F02010F00000026</part>
  </rom>
  <rom index="0" zip="ultraxg.zip|ultrax.zip">
    <!-- program -->
    <interleave output="16">
      <part name="sx010-11.5h" crc="58554bdd" map="01"/>
      <part name="sx010-09.5c" crc="153e79b2" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="sx010-12.5k" crc="14ad58c9" map="01"/>
      <part name="sx010-10.5d" crc="7e64473e" map="10"/>
    </interleave>
    <!-- graphics -->
    <part name="71047-01.u73" crc="66662b08"/>
    <part name="71047-02.u74" crc="6b00dc0c"/>
    <part name="71047-03.u76" crc="00fcd6c2"/>
    <part name="71047-04.u77" crc="d9e710d1"/>
    <part name="71047-05.u75" crc="10848193"/>
    <part name="71047-06.u88" crc="b8ac2942"/>
    <!-- samples -->
    <interleave output="16">
      <part name="71047-07.u59" crc="d9828b62" map="01"/>
    </interleave>
    <interleave output="16">
      <part name="71047-08.u60" crc="30ebff6d" map="01"/>
    </interleave>
  </rom>
  <switches default="FF,EF" base="16">
    <!-- DSW1 -->
    <dip bits="0,3" name="Coin A" ids="3C/1C,2C/1C,1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C" values="8,9,15,14,13,12,11,10"/>
    <dip bits="4,7" name="Coin B" ids="3C/1C,2C/1C,1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C" values="8,9,15,14,13,12,11,10"/>
    <!-- DSW2 -->
    <dip bits="8,9" name="Difficulty" ids="Easy,Normal,Hard,Hardest" values="2,3,1,0"/>
    <dip bits="11" name="Free Play" ids="Off,On" values="1,0"/>
    <dip bits="13" name="Demo Sounds" ids="Off,On" values="0,1"/>
    <dip bits="14" name="Flip Screen" ids="Off,On" values="1,0"/>
    <dip bits="15" name="Service Mode" ids="Off,On" values="1,0"/>
  </switches>
  <buttons names="Button 1,Button 2,Button 3,Button 4,Button 5,Button 6,Test,Service,Start,Coin" default="A,B,X,Y,L,R,R,L,Start,Select" count="10"/>
</misterromdescription>
