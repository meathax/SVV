<misterromdescription>
  <name>Dyna Gear</name>
  <setname>dynagear</setname>
  <year>1993</year>
  <manufacturer>Sammy</manufacturer>
  <rbf>SSV</rbf>
  <rom index="0" zip="dynagear.zip">
    <interleave output="16">
      <part name="si002-prl.u4" crc="71ba29c6" map="01"/>
      <part name="si002-prh.u3" crc="d0947a12" map="10"/>
    </interleave>
    <part name="si002-01.u27" crc="0060a521"/>
    <part name="si002-04.u26" crc="6140f47d"/>
    <part name="si002-02.u23" crc="c22f2a41"/>
    <part name="si002-05.u22" crc="482412fd"/>
    <part name="si002-03.u17" crc="4261a6b8"/>
    <part name="si002-06.u16" crc="0e1f23f6"/>
    <interleave output="16">
      <part name="si002-07.u9" crc="30d2bf11" map="21"/>
    </interleave>
    <interleave output="16">
      <part name="si002-08.u8" crc="253704ee" map="21"/>
    </interleave>
    <interleave output="16">
      <part name="si002-09.u7" crc="1ea86db7" map="21"/>
    </interleave>
    <interleave output="16">
      <part name="si002-10.u6" crc="e369c177" map="21"/>
    </interleave>
  </rom>
  <!-- DIP switches, straight off the board. bits 0-7 are DSW1 ($210002),
       bits 8-15 are DSW2 ($210004); the core takes them verbatim on ioctl
       index 254 and hands them to the game unmodified.

       Transcribed from MAME 0.288 INPUT_PORTS_START(dynagear) and the
       SSV_COINAGE_EXTENDED macro in src/mame/seta/ssv.cpp. Defaults FF,FD are
       MAME's: Coin A/B 1C/1C, Flip Off, Demo Sounds On, Normal, 2 lives,
       Free Play Off, 4 Hearts. Coinage value 0 is deliberately absent, since
       MAME notes the meaning of all-ON varies between SSV games. -->
  <switches default="FF,FD" base="16">
    <!-- DSW1 -->
    <dip bits="0,3"   name="Coin A"      ids="1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,2C/1C,2C/3C,3C/1C,4C/1C,Multi A,Multi B,Multi C,Multi D,Multi E" values="15,14,13,12,11,10,9,6,8,7,5,4,3,2,1"/>
    <dip bits="4,7"   name="Coin B"      ids="1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,2C/1C,2C/3C,3C/1C,4C/1C,Multi A,Multi B,Multi C,Multi D,Multi E" values="15,14,13,12,11,10,9,6,8,7,5,4,3,2,1"/>
    <!-- DSW2 -->
    <dip bits="8"     name="Flip Screen" ids="Off,On"                      values="1,0"/>
    <dip bits="9"     name="Demo Sounds" ids="On,Off"                      values="0,1"/>
    <dip bits="10,11" name="Difficulty"  ids="Easy,Normal,Hard,Hardest"    values="2,3,1,0"/>
    <dip bits="12,13" name="Lives"       ids="1,2,3,4"                     values="1,3,2,0"/>
    <dip bits="14"    name="Free Play"   ids="Off,On"                      values="1,0"/>
    <dip bits="15"    name="Health"      ids="3 Hearts,4 Hearts"           values="0,1"/>
  </switches>
  <!-- Dyna Gear uses two buttons; the board's third button input is not wired
       to anything in this game. Order must match CONF_STR "J1,..." in
       Arcade-SSV.sv. -->
  <buttons names="Fire,Jump,Test,Service,Start,Coin" default="A,B,R,L,Start,Select" count="6"/>
</misterromdescription>
