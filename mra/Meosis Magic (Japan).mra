<misterromdescription>
  <!-- Generated by tools/gen_ssv_mras.py from MAME ssv.cpp.
       Stream offsets: program 0x0000000-0x00FFFFF; graphics 0x0100000-0x08FFFFF; samples 0x0900000-0x0CFFFFF
       NOT YET SUPPORTED by the SSV core: rtl/mem/ssv_rom_loader.sv takes a fixed Dyna Gear stream (1 MB program, graphics as three 4 MB quarters, 4 MB samples) and this set does not match it. The ROM description below is correct and will work once the loader is generalised. -->
  <name>Meosis Magic (Japan)</name>
  <setname>meosism</setname>
  <year>1996</year>
  <manufacturer>Sammy</manufacturer>
  <rbf>SSV</rbf>
  <rom index="0" zip="meosism.zip">
    <!-- program -->
    <interleave output="16">
      <part name="s15-2-2.u47" crc="2ab0373f" map="01"/>
      <part name="s15-2-1.u46" crc="a4bce148" map="10"/>
    </interleave>
    <!-- graphics -->
    <part name="s15-1-7.u7" crc="ec5023cb"/>
    <part name="s15-1-8.u6" crc="f04b0836"/>
    <part name="s15-1-5.u9" crc="c0414b97"/>
    <part name="s15-1-6.u8" crc="d721aeb6"/>
    <!-- samples -->
    <interleave output="16">
      <part name="s15-1-4.u45" crc="0c6738a7" map="21"/>
    </interleave>
    <interleave output="16">
      <part name="s15-1-3.u43" crc="d7e83178" map="21"/>
    </interleave>
  </rom>
  <switches default="FF,83" base="16">
    <!-- DSW1 -->
    <dip bits="0,1" name="Coinage" ids="1 Medal/1 Credit,1 Medal/5 Credits,1 Medal/10 Credits,1 Medal/20 Credits" values="3,1,2,0"/>
    <dip bits="2" name="Demo Sounds" ids="Off,On" values="0,1"/>
    <dip bits="3" name="Attendant Pay" ids="No,Yes" values="0,1"/>
    <dip bits="4" name="Medals Payout" ids="400,800" values="1,0"/>
    <dip bits="5" name="Max Credits" ids="5000,9999" values="1,0"/>
    <dip bits="6" name="Hopper" ids="No,Yes" values="0,1"/>
    <dip bits="7" name="Reel Speed" ids="Low,High" values="1,0"/>
    <!-- DSW2 -->
    <dip bits="8,9" name="Game Rate" ids="80%,85%,90%,95%" values="0,2,3,1"/>
    <dip bits="13" name="Controls" ids="Simple,Complex" values="1,0"/>
    <dip bits="14" name="Coin Sensor" ids="Active High,Active Low" values="1,0"/>
    <dip bits="15" name="Hopper Sensor" ids="Off,On" values="1,0"/>
  </switches>
  <buttons names="Button 1,Button 2,Test,Service,Start,Coin" default="A,B,R,L,Start,Select" count="6"/>
</misterromdescription>
