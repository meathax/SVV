{
  "schema_version": 4,
  "runtime": {
    "managed_version": "5.1.1",
    "minimum_version": "5.1.1"
  },
  "project": {
    "name": "SSV",
    "game": "SSV universal nine-set profile",
    "board": "Seta/Sammy Visco SSV",
    "status": "gameplay_convergence_in_progress"
  },
  "paths": {
    "mame_exe": "D:\\Arcade\\AI\\mameexe\\mame.exe",
    "mame_source": "D:\\Arcade\\AI\\mame289",
    "mame_roms": "D:\\Arcade\\AI\\MAME 0.289 ROMs (merged)",
    "mame_mcp_root": "D:\\Arcade\\AI\\mame",
    "verilator": "C:\\msys64\\ucrt64\\bin\\verilator.exe",
    "quartus_root": "D:\\Q17",
    "modelsim_root": "D:\\Q17\\modelsim"
  },
  "mame": {
    "shortname": "dynagear",
    "driver_source": "src/mame/seta/ssv.cpp",
    "machine": "ssv",
    "rom_files": [
      "dynagear.zip", "vasara.zip", "vasara2.zip", "cairblad.zip",
      "drifto94.zip", "stmblade.zip", "twineag2.zip", "ultrax.zip",
      "survartsu.zip"
    ],
    "capture_task": "mame_capture",
    "source_inputs": ["mame0289", "src/mame/seta/ssv.cpp", "src/mame/seta/ssv_v.cpp"],
    "supported_setnames": [
      "dynagear", "survartsu", "cairblad", "vasara", "vasara2",
      "ultrax", "stmblade", "drifto94", "twineag2"
    ],
    "version_expected": "0.289 (mame0289)",
    "reference_mutation_forbidden": true
  },
  "rtl": {
    "top": "tb_ssv_frame_crc",
    "simulation_top": "tb_ssv_frame_crc",
    "source_globs": [
      "rtl/**/*.sv", "verif/tb_ssv_frame_crc.sv",
      "verif/ssv_diff_probe.sv", "verif/ssv_headless_main.cpp"
    ],
    "lint_task": "verilator_lint",
    "build_task": "verilator_build",
    "capture_task": "rtl_capture",
    "regression_task": "regression"
  },
  "quartus": {
    "qpf": "Arcade-SSV.qpf",
    "revision": "Arcade-SSV",
    "top": "sys_top",
    "sdc_files": ["Arcade-SSV.sdc"],
    "analysis_task": "quartus_analysis",
    "full_task": "quartus_full",
    "output_rbf": "releases/Arcade-SSV.rbf",
    "report_dir": "output_files",
    "gates": {
      "require_fresh_reports": true,
      "max_errors": 0,
      "max_critical_warnings": 0,
      "min_setup_slack_ns": 0.0,
      "min_hold_slack_ns": 0.0,
      "allow_unconstrained_paths": false
    }
  },
  "capture": {
    "raw_schema": "mister-raw-trace-v4",
    "canonical_schema": "mister-canonical-trace-v4",
    "context_events": 8,
    "diagnostic_resync_window": 0,
    "max_raw_trace_bytes": 4294967296,
    "retain_successful_runs": 2,
    "retain_failed_runs": 8,
    "write_sha256_sidecars": true
  },
  "resources": {
    "max_heavy_jobs": 1,
    "job_count": 1,
    "reserve_logical_cpus": 4,
    "job_cap": 4,
    "global_lock_timeout_s": 7200
  },
  "tasks": {
    "verilator_build": {
      "argv": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/build_ssv_headless.ps1"],
      "cwd": ".",
      "enabled": true,
      "heavy": true,
      "timeout_s": 3600,
      "env": {"MISTER_DIFF_HEADLESS": "1", "VERILATOR_THREADS": "1"},
      "cache": {
        "enabled": true,
        "inputs": ["rtl/**/*", "verif/ssv_diff_probe.sv", "verif/ssv_headless_main.cpp", "verif/tb_ssv_frame_crc.sv"],
        "outputs": ["C:/tmp/ssv_obj_headless/Vtb_ssv_frame_crc.exe"]
      }
    },
    "rtl_capture": {
      "argv": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/run_ssv_headless.ps1", "-Set", "${MISTER_SCENARIO}", "-Session", "sim_output/diff/${MISTER_SCENARIO}-${MISTER_CAPTURE_INDEX}", "-Scenario", "gameplay_neutral", "-ScenarioFile", "verif/scenarios/${MISTER_SCENARIO}/gameplay_neutral.json", "-SkipBuild"],
      "cwd": ".",
      "enabled": true,
      "heavy": true,
      "timeout_s": 7200,
      "env": {"MISTER_DIFF_HEADLESS": "1", "VERILATOR_THREADS": "1"},
      "cache": {
        "enabled": false,
        "inputs": ["rtl/**/*", "verif/**/*", "sim_output/rom/**/*"],
        "outputs": ["sim_output/diff/**/*"]
      }
    },
    "mame_capture": {
      "argv": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/run_ssv_mame_headless.ps1", "-Set", "${MISTER_SCENARIO}", "-Session", "sim_output/diff/${MISTER_SCENARIO}-${MISTER_CAPTURE_INDEX}", "-ScenarioFile", "verif/scenarios/${MISTER_SCENARIO}/gameplay_neutral.json"],
      "cwd": ".",
      "enabled": true,
      "heavy": true,
      "timeout_s": 7200,
      "env": {"MISTER_DIFF_HEADLESS": "1"},
      "cache": {
        "enabled": false,
        "inputs": ["tools/mame-ssv-headless.lua", "verif/input_journals/**/*"],
        "outputs": ["sim_output/diff/**/*"]
      }
    },
    "verilator_lint": {
      "argv": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/build_ssv_headless.ps1", "-PrintExecutable"], "cwd": ".", "enabled": false, "heavy": false, "timeout_s": 900, "env": {}
    },
    "regression": {
      "argv": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "verif/run_all_focused_no_rbf.ps1"], "cwd": ".", "enabled": false, "heavy": true, "timeout_s": 7200, "env": {}
    },
    "quartus_analysis": {
      "argv": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/build-ssv.ps1", "-QuartusRoot", "D:\\Q17"], "cwd": ".", "enabled": false, "heavy": true, "timeout_s": 7200, "env": {}
    },
    "quartus_full": {
      "argv": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/build-ssv.ps1", "-QuartusRoot", "D:\\Q17"], "cwd": ".", "enabled": false, "heavy": true, "timeout_s": 14400, "env": {}
    },
    "hardware_test": {
      "argv": ["powershell", "-NoProfile", "-Command", "Write-Error 'hardware_test requires a connected MiSTer host'; exit 3"], "cwd": ".", "enabled": false, "heavy": false, "timeout_s": 3600, "env": {}
    }
  },
  "scenarios": {
